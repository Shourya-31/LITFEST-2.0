{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": ["tests/**/*.ts", "src/features/game/**/*.ts", "src/features/atlantis/**/*.ts", "src/services/game-service.ts", "src/services/auth.ts", "src/types/game.ts"]
}
