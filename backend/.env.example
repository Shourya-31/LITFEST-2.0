# Copy to `.env` and replace placeholders; never commit real credentials.
# Runtime URL: use the pooled Neon URL for application traffic where appropriate.
# Include sslmode=require for Neon.
DATABASE_URL="******HOST:5432/DATABASE?sslmode=require"

# Optional migration URL. Prefer the direct (non-pooler) Neon URL for Prisma Migrate.
# If omitted, migrations continue to use DATABASE_URL.
# DIRECT_URL="******HOST:5432/DATABASE?sslmode=require"
